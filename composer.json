{
    "name": "maeandrew/laya-laravel",
    "description": "Laya as a first-class classification provider for laravel/ai: typed choice, score and yes/no decisions from a self-hosted, multilingual System 1 model.",
    "keywords": ["laravel", "ai", "classification", "laya", "system-one", "decisions"],
    "license": "MIT",
    "homepage": "https://github.com/maeandrew/laya-laravel",
    "support": {
        "issues": "https://github.com/maeandrew/laya-laravel/issues",
        "source": "https://github.com/maeandrew/laya-laravel"
    },
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.0@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.6|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Laya\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laya\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:lint": "@php vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laya\\Laravel\\LayaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
